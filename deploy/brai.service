[Unit]
Description=Brai Personal AI Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/local/bin/brai
Restart=on-failure
RestartSec=5s

# Environment — secrets loaded from /etc/brai/env
# Copy deploy/brai.env.example to /etc/brai/env on the VPS, fill in values
EnvironmentFile=/etc/brai/env

# Brai config dir
Environment=BRAI_CONFIG_DIR=/home/ubuntu/.brai

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brai

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/.brai /home/ubuntu/brai-storage /home/ubuntu/apps
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
